# Neon Postgres (Dashboard Neon > Connect > connection string)
# In locale, senza Neon: DATABASE_URL="pglite:./.pglite"
DATABASE_URL="postgres://user:password@host/db-name?sslmode=require"

# Indirizzo pubblico dell'app, usato nei link delle email
PUBLIC_APP_URL="https://neural-notes.vercel.app"

# Registrazione: "open" (default) o "closed". Con SIGNUP_CODE serve il codice d'invito.
SIGNUP_MODE="open"
SIGNUP_CODE=""

# Email con Gmail: verifica in due passaggi + password per le app (Account Google > Sicurezza).
# Senza SMTP_URL le email vengono stampate nel log. Vanno bene anche il formato senza smtps://,
# la @ dell'indirizzo non codificata (%40) e gli spazi nella password per le app.
SMTP_URL="smtps://utente%40gmail.com:password-per-le-app@smtp.gmail.com:465"
MAIL_FROM="NEURAL//NOTES <utente@gmail.com>"

# Notifiche push (facoltative). Chiavi: npx web-push generate-vapid-keys
PUBLIC_VAPID_KEY=""
VAPID_PRIVATE_KEY=""
# URL https dell'app o un indirizzo mailto:
VAPID_SUBJECT=""
# Segreto per /api/cron/notify (ogni minuto) e /api/cron/google (ogni 15 minuti), chiamati da cron-job.org
CRON_SECRET=""

# Google (facoltativo): client OAuth "Applicazione web" con redirect https://<app>/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# 32 byte casuali in base64, cifra i token di Google Calendar (senza: solo accesso con Google)
GOOGLE_TOKEN_KEY=""
